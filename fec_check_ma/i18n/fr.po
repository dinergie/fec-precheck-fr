msgstr "La date de début doit précéder la date de fin."

#. module: fec_check_ma
#. odoo-python
#: code:addons/fec_check_ma/models/fec_check.py:0
msgid ""
"The totals of the individual accounts must match the collective accounts "
"(point 2.5 of opinion no. 24). Set the partner on the line."
msgstr ""
"Les totaux des comptes individuels doivent égaler ceux des comptes "
"collectifs (point 2.5 de l'avis n° 24). Renseignez le tiers sur la ligne."

#. module: fec_check_ma
#. odoo-python
#: code:addons/fec_check_ma/models/fec_check.py:0
